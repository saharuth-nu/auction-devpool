<!DOCTYPE html>
<html lang="th">
  <head>
    <title><%= content_for(:title) || "Auction Devpool" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Auction Devpool">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# ฟอนต์หลักของมาตรฐาน UI (DESIGN.md) %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="ui-skip-link" href="#main">ข้ามไปยังเนื้อหา</a>
    <header class="ui-header">
      <%= link_to "Auction Devpool", (authenticated? && current_user.admin? ? admin_root_path : root_path), class: "ui-header__brand" %>
      <% if authenticated? %>
        <nav class="ui-header__nav" aria-label="เมนูหลัก">
          <%= link_to current_user.fullname.presence || current_user.username, profile_path, class: "ui-header__user" %>
          <%= ui_button_to "ออกจากระบบ", logout_path, method: :delete, variant: :ghost, size: :sm %>
        </nav>
      <% end %>
    </header>
    <main id="main" class="ui-main">
      <%= ui_flash %>
      <%= yield %>
    </main>
  </body>
</html>
