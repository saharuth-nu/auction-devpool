<%# รูปที่บันทึกแล้วของสินค้า (removable: แสดงปุ่มลบทีละรูป) %>
<% saved = item.images.attachments.select(&:persisted?) %>
<% if saved.empty? %>
  <p class="ui-field__hint">ยังไม่มีรูป</p>
<% else %>
  <ul class="ui-thumbs">
    <% saved.each_with_index do |image, index| %>
      <li class="ui-thumbs__item">
        <%= image_tag image, alt: "#{item.name} รูปที่ #{index + 1}" %>
        <% if local_assigns[:removable] %>
          <%= ui_button_to "ลบรูป", admin_item_image_path(item, image), method: :delete, variant: :danger_outline, size: :sm,
                data: { turbo_confirm: "ลบรูปที่ #{index + 1}?" } %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
