<%# รูปที่บันทึกแล้วของสินค้าตามลำดับ (removable: แสดงปุ่มเลื่อนและลบทีละรูป) %>
<% images = item.ordered_images %>
<% if images.empty? %>
  <%= ui_empty_state "ยังไม่มีรูป" %>
<% else %>
  <ol class="ui-thumbs">
    <% images.each_with_index do |image, index| %>
      <li class="ui-thumbs__item">
        <%= image_tag image, alt: "#{item.name} รูปที่ #{index + 1}" %>
        <% if local_assigns[:removable] %>
          <div class="ui-actions">
            <%= ui_button_to "←", move_admin_item_image_path(item, image, direction: "up"), method: :patch,
                  variant: :secondary, size: :sm, disabled: index.zero?, "aria-label": "เลื่อนรูปที่ #{index + 1} ขึ้นก่อน" %>
            <%= ui_button_to "→", move_admin_item_image_path(item, image, direction: "down"), method: :patch,
                  variant: :secondary, size: :sm, disabled: index == images.size - 1, "aria-label": "เลื่อนรูปที่ #{index + 1} ไปหลัง" %>
            <%= ui_confirm_button "ลบรูป", admin_item_image_path(item, image), trigger_variant: :danger_outline, size: :sm,
                  title: "ลบรูปนี้?", message: "ลบรูปที่ #{index + 1} ของ “#{item.name}” ถาวร กู้คืนไม่ได้" %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ol>
<% end %>
