<% content_for :title, @item.name %>
<%= ui_page_header @item.name, description: "รายละเอียดสินค้า" do %>
  <% if @item.awaiting_approval? %>
    <%= ui_confirm_button "อนุมัติ", approve_admin_item_path(@item), method: :patch, variant: :primary,
          title: "อนุมัติสินค้านี้?",
          message: "“#{@item.name}” จะเปลี่ยนเป็น พร้อมขาย และนำไปใส่การประมูลได้ ย้อนกลับเป็นรออนุมัติไม่ได้" %>
  <% end %>
  <%= ui_link_button "แก้ไข", edit_admin_item_path(@item), variant: :secondary %>
<% end %>

<%= ui_card title: "ข้อมูลสินค้า" do %>
  <dl class="ui-dl">
    <dt>สถานะ</dt><dd><%= status_badge :item, @item.status %><%= ui_badge("เก็บถาวร", tone: :muted) if @item.archived? %></dd>
    <dt>รายละเอียด</dt><dd><%= @item.description.presence ? simple_format(@item.description) : "-" %></dd>
    <dt>ราคาเริ่มต้น</dt><dd><%= baht @item.starting_price %></dd>
    <dt>ราคาขั้นต่ำ (reserve)</dt><dd><%= baht @item.reserve_price %> <span class="ui-field__hint">(ผู้ใช้ไม่เห็น)</span></dd>
    <dt>อนุมัติโดย</dt>
    <dd><%= @item.approved_by ? "#{@item.approved_by.username} เมื่อ #{l @item.approved_at, format: :short}" : "-" %></dd>
  </dl>
<% end %>

<%= ui_card title: "รูปสินค้า" do %>
  <%= render "images", item: @item %>
<% end %>

<%= ui_card title: "จัดการ" do %>
  <div class="ui-actions">
    <% unless @item.archived? %>
      <%= ui_confirm_button "เก็บถาวร", archive_admin_item_path(@item), method: :patch, trigger_variant: :secondary,
            title: "เก็บถาวรสินค้านี้?",
            message: "“#{@item.name}” จะหายจากรายการปกติและเลือกใส่การประมูลใหม่ไม่ได้ ประวัติเดิมยังดูได้" %>
    <% end %>
    <%= ui_confirm_button "ลบสินค้า", admin_item_path(@item), trigger_variant: :danger_outline,
          title: "ลบสินค้านี้?", message: "ลบ “#{@item.name}” และรูปทั้งหมดถาวร กู้คืนไม่ได้" %>
    <%= ui_link_button "กลับไปรายการสินค้า", admin_items_path, variant: :ghost %>
  </div>
<% end %>
