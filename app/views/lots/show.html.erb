<% content_for :title, @item.name %>
<%= ui_back_link "กลับหน้าแรก", root_path %>
<%= ui_page_header @item.name do %>
  <%= lot_phase_badge(@event) %>
<% end %>

<div class="ui-lot">
  <section class="ui-lot__gallery" aria-label="รูปสินค้า">
    <%= render "lots/gallery", item: @item %>
  </section>

  <div class="ui-lot__info">
    <%= ui_card title: "รายละเอียดการประมูล" do %>
      <dl class="ui-dl">
        <dt>ราคาเริ่มต้น</dt><dd class="ui-lot__price"><%= baht @item.starting_price %></dd>
        <dt>เวลาประมูล</dt><dd><%= display_time @event.starts_at %></dd>
        <dt>ห้อง</dt><dd><%= @event.room.name %></dd>
        <dt>การประมูล</dt><dd><%= @event.name %></dd>
        <dt>วิธีประมูล</dt><dd><%= @event.auction_method.name %></dd>
        <dt>ยื่นราคาได้ภายใน</dt><dd><%= bidding_window_text(@event.auction_method) %></dd>
        <dt>ผู้เข้าร่วม</dt><dd><%= @participants %> / <%= @event.room.max_participants %> คน</dd>
      </dl>
    <% end %>

    <%= render "lots/join", lot: @lot, event: @event, participation: @participation, full: @full %>
  </div>
</div>

<%= ui_card title: "รายละเอียดสินค้า" do %>
  <% if @item.description.present? %>
    <%= simple_format(@item.description) %>
  <% else %>
    <p class="ui-text-muted">ยังไม่มีรายละเอียด</p>
  <% end %>
<% end %>

